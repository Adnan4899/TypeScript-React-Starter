bel" export default function App() { const [activeTab, setActiveTab] = useState('home') const [text, setText] = useState('') const [formattedText, setFormattedText] = useState('') const [feedback, setFeedback] = useState('') const handleTextChange = (event: React.ChangeEvent<HTMLTextAreaElement>) => { setText(event.target.value) setFormattedText(event.target.value) } const applyFormatting = (format: 'bold' | 'italic' | 'underline') => { const input = document.getElementById('text-input') as HTMLTextAreaElement const start = input.selectionStart const end = input.selectionEnd const selectedText = text.substring(start, end) let formatted switch (format) { case 'bold': formatted = `<strong>${selectedText}</strong>` break case 'italic': formatted = `<em>${selectedText}</em>` break case 'underline': formatted = `<u>${selectedText}</u>` break default: formatted = selectedText } const newText = text.substring(0, start) + formatted + text.substring(end) setText(newText) setFormattedText(newText) // Move the cursor to the end of the formatted text input.focus() input.setSelectionRange(start + formatted.length, start + formatted.length) } const handleFeedbackChange = (event: React.ChangeEvent<HTMLTextAreaElement>) => { setFeedback(event.target.value) } return ( <div className="bg-white min-h-screen"> <header className="bg-blue-500 text-white p-4"> <div className="max-w-4xl mx-auto flex justify-between items-center"> <h1 className="text-2xl font-bold">Student Hub</h1> <nav> <Button variant="ghost" onClick={() => setActiveTab('home')}>Home</Button> <Button variant="ghost" onClick={() => setActiveTab('notes')}>Notes</Button> <Button variant="ghost" onClick={() => setActiveTab('ai-tools')}>AI Tools</Button> <Button variant="ghost" onClick={() => setActiveTab('streams')}>Streams</Button> <Button variant="ghost" onClick={() => setActiveTab('feedback')}>Feedback</Button> <Button variant="ghost" onClick={() => setActiveTab('control-panel')}>Control Panel</Button> </nav> </div> </header> <main className="max-w-4xl mx-auto p-4"> {activeTab === 'home' && ( <div> <Card className="mb-4"> <CardHeader> <CardTitle>Welcome to Student Hub</CardTitle> <CardDescription> This app is designed to help students with their notes and provide AI-driven assistance. </CardDescription> </CardHeader> <CardContent> <p> Developed by Adnan Manzoor, the founder of Learning Hub, this app offers a range of tools to enhance your online learning experience. </p> <p className="mt-2"> <strong>Features:</strong> Notes section, AI tools, and more! </p> <p className="mt-2"> <strong>Dreams:</strong> Achieve your academic goals with ease. </p> <p className="mt-2"> <strong>Exams Feel Free:</strong> Focus on study without stress. </p> </CardContent> </Card> <Card> <CardHeader> <CardTitle>About Me</CardTitle> </CardHeader> <CardContent className="flex items-center space-x-4"> <Avatar> <AvatarImage src="https://github.com/your-github-profile.png" /> <AvatarFallback>AD</AvatarFallback> </Avatar> <div> <CardTitle>Adnan Manzoor</CardTitle> <CardDescription>Founder of Learning Hub</CardDescription> </div> </CardContent> </Card> </div> )} {activeTab === 'notes' && ( <div> <div className="mb-4"> <Textarea id="text-input" value={text} onChange={handleTextChange} className="w-full h-40" placeholder="Type your notes here..." /> </div> <div className="flex space-x-2 mb-4"> <Button onClick={() => applyFormatting('bold')}> <Bold className="h-4 w-4" /> </Button> <Button onClick={() => applyFormatting('italic')}> <Italic className="h-4 w-4" /> </Button> <Button onClick={() => applyFormatting('underline')}> <Underline className="h-4 w-4" /> </Button> </div> <div className="border p-4 rounded"> <div className="prose" dangerouslySetInnerHTML={{ __html: formattedText }} /> </div> </div> )} {activeTab === 'ai-tools' && ( <div> <Card className="mb-4"> <CardHeader> <CardTitle>AI Tools</CardTitle> <CardDescription>Assist with your online work</CardDescription> </CardHeader> <CardContent> <div className="space-y-4"> <Button variant="secondary">AI Tool 1: Research Assistant</Button> <Button variant="secondary">AI Tool 2: Writing Assistant</Button> <Button variant="secondary">AI Tool 3: Time Management Assistant</Button> </div> </CardContent> </Card> </div> )} {activeTab === 'streams' && ( <div> <Card className="mb-4"> <CardHeader> <CardTitle>Streams and Subjects</CardTitle> <CardDescription>Guides for different streams</CardDescription> </CardHeader> <CardContent> <div className="space-y-4"> <div> <h3 className="text-lg font-bold">Science Stream</h3> <ul className="list-disc list-inside"> <li>Physics</li> <li>Chemistry</li> <li>Biology</li> </ul> </div> <div> <h3 className="text-lg font-bold">Commerce Stream</h3> <ul className="list-disc list-inside"> <li>Accountancy</li> <li>Business Studies</li> <li>Economics</li> </ul> </div> <div> <h3 className="text-lg font-bold">Arts Stream</h3> <ul className="list-disc list-inside"> <li>History</li> <li>Geography</li> <li>Political Science</li> </ul> </div> </div> </CardContent> </Card> </div> )} {activeTab === 'feedback' && ( <div> <Card> <CardHeader> <CardTitle>Feedback</CardTitle> <CardDescription>Share your thoughts with us</CardDescription> </CardHeader> <CardContent> <div className="space-y-4"> <Textarea value={feedback} onChange={handleFeedbackChange} className="w-full h-40" placeholder="Your feedback here..." /> <Button variant="secondary">Submit Feedback</Button> </div> </CardContent> </Card> </div> )} {activeTab === 'control-panel' && ( <div> <Card> <CardHeader> <CardTitle>Control Panel</CardTitle> <CardDescription>Admin Features</CardDescription> </CardHeader> <CardContent> <p>This section is accessible only to you.</p> <div className="space-y-4 mt-4"> <Button variant="destructive">Delete All Notes</Button> <Button variant="outline">Update Settings</Button> </div> </CardContent> </Card> </div> )} </main> </div> ) } Share Refresh Version 3 of 3
